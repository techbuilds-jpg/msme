# ---- Browser (safe to expose; every table is protected by Row Level Security) ----
# Supabase dashboard → Project Settings → API. Use the *publishable* (or legacy anon) key, never the service-role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Cloudflare Turnstile site key (public). Leave empty to skip the bot check in local dev.
# The matching SECRET key goes only in Supabase → Auth → Attack Protection, never here.
VITE_TURNSTILE_SITE_KEY=

# No server-side secrets are needed yet. If a Netlify Function is added later, its secrets go in the
# Netlify UI (never prefixed with VITE_, never committed).
